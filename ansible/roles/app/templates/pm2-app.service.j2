[Unit]
Description=PM2 - {{ book_review_pm2_app_name }}
After=network.target

[Service]
Type=forking
User={{ book_review_app_user }}
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
Environment=PATH=/home/{{ book_review_app_user }}/.nvm/versions/node/v*/bin:/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/home/{{ book_review_app_user }}/.pm2
WorkingDirectory={{ book_review_app_dir }}/{{ backend_files_dir }}
ExecStart=pm2 start src/server.js --name "{{ book_review_pm2_app_name }}"
ExecReload=pm2 reload "{{ book_review_pm2_app_name }}" --update-env
ExecStop=pm2 stop "{{ book_review_pm2_app_name }}"
PIDFile=/home/{{ book_review_app_user }}/.pm2/pm2.pid
Restart=on-failure

[Install]
WantedBy=multi-user.target
