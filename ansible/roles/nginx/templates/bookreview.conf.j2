server {
    listen 80 default_server;     
    server_name _;

    location / {                                         
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://{{ api_private_ip }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # NEW: Handle requests that start with /book/api/
    # The Next.js frontend has basePath: '/book' set, causing API calls to go to /book/api/books/1
    # Nginx was only proxying /api/, resulting in 404 errors
    # Removes the /book prefix before forwarding to the backend, so the backend receives /api/books/1
    
    location /book/api/ {
        # Remove the /book prefix and pass the remaining path to the backend
        rewrite ^/book/api/(.*) /api/$1 break;
        proxy_pass http://{{ api_private_ip }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
