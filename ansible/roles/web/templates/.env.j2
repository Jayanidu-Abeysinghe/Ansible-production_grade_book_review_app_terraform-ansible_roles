# Next.js Production Environment Variables

# Frontend (client-side JavaScript) uses it.
# The browser cannot access 10.0.11.163 (it's a private IP). So we tell the browser to ask the same server it got the webpage from (Nginx), and Nginx will figure out the rest.
# Can't change the name because the frontend source code specifically looks for this exact name.
NEXT_PUBLIC_API_URL=.        
NODE_ENV=production

# NEXT_PUBLIC_API_URL=. means the browser will send API requests to the same web server (the same frontend IP address) instead of trying to reach localhost:3001 or a hardcoded IP.
# then Request goes to Nginx
# then Nginx proxies the request to the backend server (10.0.11.163)